# Express API origin used by the server-side login and data proxies.
BACKEND_URL=http://localhost:5000

# At least 32 random characters. Used to sign the httpOnly session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret between Next.js BFF and Express backend to block direct requests.
INTERNAL_API_SECRET=replace-with-a-long-random-string
